# FALK Environment Configuration
# Copy this file to .env and fill in real values (never commit .env)

# ── AWS (for S3 WORM backups - Step B) ──────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Kafka (for live data - Step C) ──────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=market-data

# ── OIDC (for authentication - Step D) ──────────────────────
OIDC_ISSUER=
OIDC_AUDIENCE=falk-api
OIDC_JWKS_URL=

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Safety ──────────────────────────────────────────────────
# NEVER commit real .env to git
# Rotate AWS keys every 90 days
# Use IAM roles instead of keys where possible
